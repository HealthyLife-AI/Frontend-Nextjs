# Server-only — used by the /api/auth/* BFF routes (see README
# "Authentication"). The refresh token must never reach the browser, so
# auth calls are proxied through this server-side value.
LARAVEL_API_URL=http://127.0.0.1:8000/api/v1

# Public — the browser calls Laravel directly for authenticated DATA
# endpoints (clients, health profiles, foods, dashboard) using the
# in-memory access token (AuthProvider.authorizedFetch()). Usually the
# same value as above; only differs behind a reverse proxy where the
# server-side and browser-facing URLs for the API aren't identical.
NEXT_PUBLIC_LARAVEL_API_URL=http://127.0.0.1:8000/api/v1

# Public — "Continue with Google" on the sign-in/sign-up screens. The OAuth
# web client id from Google Cloud Console; must equal the backend's
# GOOGLE_CLIENT_ID. Leave blank to hide the Google button entirely.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
